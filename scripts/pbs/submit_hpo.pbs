#!/bin/bash
#PBS -j oe

# ============================================================================
# PBS Pro HPO Worker Script for ParticleMan
# ============================================================================
#
# Runs one Optuna HPO worker (single GPU). Submit multiple copies of this
# script with the same --study-name and --storage to run trials in parallel.
# Optuna coordinates across workers via the shared SQLite (or RDB) study.
#
# Usage (via submit_hpo.sh):
#   bash scripts/submit_hpo.sh 4
#
# Or manually:
#   STORAGE="sqlite:////path/on/shared/fs/hpo_study.db"
#   HPO_ARGS="--study-name my_study --storage ${STORAGE} --data-config bbllv08_classify --mode classify --epochs 5 --trials 5"
#   qsub -l select=1:ngpus=1 -v HPO_ARGS="${HPO_ARGS}" scripts/pbs/submit_hpo.pbs
#
# Environment variables:
#   HPO_ARGS  (required) — CLI arguments forwarded verbatim to scripts/hpo.py
#
# ============================================================================

#set -e

source /home/sheesh/ParticleMan/scripts/pbs/utils.sh
setup_envs

# ============================================================================
# Launch training
# ============================================================================

TRAIN_SCRIPT="scripts/hpo.py"

if [ -z "${HPO_ARGS}" ]; then
    echo "ERROR: HPO_ARGS environment variable is not set."
    echo "Set it via:  qsub -v HPO_ARGS='--study-name ... --storage ...' scripts/pbs/submit_hpo.pbs"
    exit 1
fi

# Each worker uses only the first visible GPU
export CUDA_VISIBLE_DEVICES=0

echo ""
echo "HYDRA args: ${HYDRA_ARGS}"
echo ""


echo ""
echo "HPO args: ${HPO_ARGS}"
echo ""

#python scripts/hpo.py ${HPO_ARGS}

# mpiexec: launch across all processes; train.py must read MPI rank env vars
echo "Running distributed training with mpiexec..."
NODEFILE=${PBS_NODEFILE}
PYTHON_CMD="python ${TRAIN_SCRIPT} ${HPO_ARGS}"
bash_cmd='
        export RANK=$PMI_RANK
        export LOCAL_RANK=$((PMI_RANK % NGPUS_PER_NODE))
        export CUDA_VISIBLE_DEVICES=$LOCAL_RANK
        echo "host=$(hostname) RANK=$RANK LOCAL_RANK=$LOCAL_RANK CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
        python $TRAIN_SCRIPT $HYDRA_ARGS $HPO_ARGS
    '
echo "Bash CMD"
echo $bash_cmd
echo "python ${TRAIN_SCRIPT} ${HYDRA_ARGS} ${HPO_ARGS}"
launch_cmd=(
mpiexec \
    -n ${TOTAL_GPUS} \
    --ppn ${NGPUS_PER_NODE} \
    --hostfile ${NODEFILE} \
    --cpu-bind none \
    -env MASTER_ADDR "$MASTER_ADDR" \
    -env MASTER_PORT "$MASTER_PORT" \
    -env WORLD_SIZE "$WORLD_SIZE" \
    -env NGPUS_PER_NODE "$NGPUS_PER_NODE"
    -env NCCL_DEBUG "$NCCL_DEBUG" \
    -env NCCL_IB_DISABLE "$NCCL_IB_DISABLE" \
    -env NCCL_NET_GDR_LEVEL "$NCCL_NET_GDR_LEVEL" \
    -env NCCL_P2P_DISABLE "$NCCL_P2P_DISABLE" \
    -env PYTHONNOUSERSITE "$PYTHONNOUSERSITE" \
    -env TRAIN_SCRIPT "$TRAIN_SCRIPT" \
    -env HYDRA_ARGS "$HYDRA_ARGS" \
    -env HPO_ARGS "$HPO_ARGS" \
    bash -lc "${bash_cmd}"
)

# ===========================================================================
# Run launch command
# ===========================================================================

echo "${launch_cmd[@]}" > hpo_launch.sh
"${launch_cmd[@]}"

echo ""
echo "=============================================="
echo "HPO worker finished at: $(date)"
echo "=============================================="
