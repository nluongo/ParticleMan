#!/bin/bash
#PBS -A ATLAS-HEP-GROUP
#PBS -N particleman_train
#PBS -l walltime=4:00:00
#PBS -q backfill
#PBS -j oe

# ============================================================================
# PBS Pro Training Script for ParticleMan
# ============================================================================
#
# Unified script for single-GPU, multi-GPU, and multi-node training.
# Automatically uses torchrun for distributed training when multiple GPUs
# or nodes are detected.
#
# Resource Selection (set via -l flag or modify defaults below):
#   Single GPU:   qsub -l select=1:ngpus=1 scripts/pbs/submit_training.pbs
#   Multi-GPU:    qsub -l select=1:ngpus=4 scripts/pbs/submit_training.pbs
#   Multi-node:   qsub -l select=2:ngpus=4 scripts/pbs/submit_training.pbs
#
# Training Parameters (override via -v flag):
#   qsub -v EPOCHS=20,BATCH_SIZE=64,LR=1e-3 scripts/pbs/submit_training.pbs
#
# Full example:
#   qsub -l select=2:ncpus=16:ngpus=4:mem=64gb \
#        -v EXPERIMENT_NAME=my_exp,EPOCHS=50 \
#        scripts/pbs/submit_training.pbs
#
# Output directory structure (managed by OutputManager):
#   outputs/<experiment_name>/<timestamp>_pbs<jobid>/
#   ├── checkpoints/
#   ├── logs/
#   ├── config.json
#   ├── job_info.json
#   ├── output.log
#   ├── pbs_output.log   # PBS stdout/stderr (copied at job end)
#   └── summary.json
#
# ============================================================================

# Exit on error
set -e

# Print job information
echo "=============================================="
echo "PBS Job ID: ${PBS_JOBID}"
echo "Running on host: $(hostname)"
echo "Start time: $(date)"
echo "Working directory: ${PBS_O_WORKDIR}"
echo "=============================================="

# Change to working directory
cd "${PBS_O_WORKDIR}"

# Load required modules (adjust for your system)
# module load cuda/11.8
# module load python/3.11

# Activate virtual environment
source .venv/bin/activate

# ============================================================================
# Determine cluster topology
# ============================================================================

# Get number of nodes from PBS
if [ -n "${PBS_NODEFILE}" ]; then
    NNODES=$(cat "${PBS_NODEFILE}" | sort -u | wc -l)
    NODES=($(cat "${PBS_NODEFILE}" | sort -u))
    MASTER_ADDR=${NODES[0]}
else
    NNODES=1
    MASTER_ADDR="localhost"
fi

# Get GPUs per node: use NGPUS_PER_NODE if set, otherwise detect
if [ -z "${NGPUS_PER_NODE}" ]; then
    NGPUS_PER_NODE=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l || echo 1)
fi

TOTAL_GPUS=$((NNODES * NGPUS_PER_NODE))
MASTER_PORT=${MASTER_PORT:-29500}

echo ""
echo "Cluster topology:"
echo "  Nodes: ${NNODES}"
echo "  GPUs per node: ${NGPUS_PER_NODE}"
echo "  Total GPUs: ${TOTAL_GPUS}"
echo "  Master: ${MASTER_ADDR}:${MASTER_PORT}"
if [ ${NNODES} -gt 1 ]; then
    echo "  Node list: ${NODES[*]}"
fi

# ============================================================================
# Training parameters (override via -v flag)
# ============================================================================

echo "Config: ${CONFIG}"
CONFIG=${CONFIG:-"configs/mc20_ttbar.yaml"}
EXPERIMENT_NAME=${EXPERIMENT_NAME:-"ParticleMan_mc20_ttbar"}
OUTPUT_DIR=${OUTPUT_DIR:-"outputs"}
MAX_EVENTS=${MAX_EVENTS:-"10000"}
EPOCHS=${EPOCHS:-80}
BATCH_SIZE=${BATCH_SIZE:-32}  # Per GPU
LR=${LR:-1e-4}
D_MODEL=${D_MODEL:-256}
N_LAYERS=${N_LAYERS:-6}
N_HEADS=${N_HEADS:-8}
DROPOUT=${DROPOUT:-0.1}
EMBEDDING=${EMBEDDING:-"joint"}
PHI_ENCODING=${PHI_ENCODING:-"sincos"}
NUM_WORKERS=${NUM_WORKERS:-4}

EFFECTIVE_BATCH_SIZE=$((BATCH_SIZE * TOTAL_GPUS))

echo ""
echo "Training parameters:"
echo "  Config: ${CONFIG}"
echo "  Experiment: ${EXPERIMENT_NAME}"
echo "  Output dir: ${OUTPUT_DIR}"
echo "  Max events: ${MAX_EVENTS}"
echo "  Epochs: ${EPOCHS}"
echo "  Batch size per GPU: ${BATCH_SIZE}"
echo "  Effective batch size: ${EFFECTIVE_BATCH_SIZE}"
echo "  Learning rate: ${LR}"
echo "  Model dim: ${D_MODEL}"
echo "  Layers: ${N_LAYERS}"
echo "  Heads: ${N_HEADS}"
echo "  Dropout: ${DROPOUT}"
echo "  Embedding: ${EMBEDDING}"
echo "  Phi encoding: ${PHI_ENCODING}"
echo ""

# ============================================================================
# Set environment variables
# ============================================================================

export CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((NGPUS_PER_NODE-1)))
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export NCCL_DEBUG=${NCCL_DEBUG:-WARN}

# For multi-node: set network interface if needed
# export NCCL_SOCKET_IFNAME=eth0

# ============================================================================
# Launch training
# ============================================================================

TRAIN_SCRIPT="scripts/train.py"
TRAIN_ARGS="\
    --config-name=${CONFIG} \
    output.experiment_name=${EXPERIMENT_NAME} \
    output.output_dir=${OUTPUT_DIR} \
    data.max_events=${MAX_EVENTS} \
    training.epochs=${EPOCHS} \
    training.batch_size=${BATCH_SIZE} \
    training.lr=${LR} \
    training.num_workers=${NUM_WORKERS} \
    model.d_model=${D_MODEL} \
    model.n_layers=${N_LAYERS} \
    model.n_heads=${N_HEADS} \
    model.dropout=${DROPOUT} \
    model.embedding=${EMBEDDING} \
    model.phi_encoding=${PHI_ENCODING} \
    "

if [ ${NNODES} -eq 1 ] && [ ${NGPUS_PER_NODE} -eq 1 ]; then
    # Single GPU: run directly
    echo "Running single-GPU training..."
    python ${TRAIN_SCRIPT} ${TRAIN_ARGS}

elif [ ${NNODES} -eq 1 ]; then
    # Single node, multi-GPU: use torchrun standalone
    echo "Running multi-GPU training on single node..."
    torchrun \
        --standalone \
        --nproc_per_node=${NGPUS_PER_NODE} \
        ${TRAIN_SCRIPT} ${TRAIN_ARGS}

else
    # Multi-node: use torchrun with rendezvous
    echo "Running multi-node training..."
    
    # Get this node's rank
    HOSTNAME=$(hostname)
    NODE_RANK=0
    for i in "${!NODES[@]}"; do
        if [[ "${NODES[$i]}" == "${HOSTNAME}"* ]]; then
            NODE_RANK=$i
            break
        fi
    done
    
    echo "This node: ${HOSTNAME}, rank: ${NODE_RANK}"
    
    torchrun \
        --nnodes=${NNODES} \
        --nproc_per_node=${NGPUS_PER_NODE} \
        --node_rank=${NODE_RANK} \
        --master_addr=${MASTER_ADDR} \
        --master_port=${MASTER_PORT} \
        ${TRAIN_SCRIPT} ${TRAIN_ARGS}
fi

echo ""
echo "=============================================="
echo "Training completed at: $(date)"
echo "Outputs saved to: ${OUTPUT_DIR}/${EXPERIMENT_NAME}/"
echo "=============================================="

# ============================================================================
# Copy PBS output file to run directory
# ============================================================================

PBS_JOB_NUM=$(echo "${PBS_JOBID}" | cut -d'.' -f1)

# Match by PBS job ID suffix - safe for concurrent jobs
RUN_DIR=$(ls -d "${OUTPUT_DIR}/${EXPERIMENT_NAME}/"*_pbs${PBS_JOB_NUM} 2>/dev/null)

if [ -n "${RUN_DIR}" ] && [ -d "${RUN_DIR}" ]; then
    PBS_OUTPUT_FILE="${PBS_O_WORKDIR}/particleman_train.o${PBS_JOB_NUM}"
    if [ -f "${PBS_OUTPUT_FILE}" ]; then
        cp "${PBS_OUTPUT_FILE}" "${RUN_DIR}/pbs_output.log"
        echo "PBS output copied to: ${RUN_DIR}/pbs_output.log"
    fi
else
    echo "Warning: Could not find run directory matching *_pbs${PBS_JOB_NUM}"
fi
