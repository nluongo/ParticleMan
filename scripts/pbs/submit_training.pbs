#!/bin/bash
#PBS -j oe

# ============================================================================
# PBS Pro Training Script for ParticleMan
# ============================================================================
#
# Unified script for single-GPU, multi-GPU, and multi-node training.
# Automatically uses torchrun for distributed training when multiple GPUs
# or nodes are detected.
#
# This script is intended to be submitted via scripts/submit.py, which sets
# PBS resource flags (-A, -N, -q, -l walltime, -l select) and passes all
# training configuration as a single HYDRA_ARGS environment variable.
#
# Usage:
#   python scripts/submit.py data=bbllv08 training.epochs=80
#   python scripts/submit.py --pbs multi_gpu data=bbllv08 model.d_model=256
#
# Output directory structure (managed by OutputManager):
#   outputs/<experiment_name>/<timestamp>_pbs<jobid>/
#   ├── checkpoints/
#   ├── logs/
#   ├── config.json
#   ├── job_info.json
#   ├── output.log
#   ├── pbs_output.log   # PBS stdout/stderr (copied at job end)
#   └── summary.json
#
# ============================================================================

# Exit on error
#set -e

# Print job information
echo "=============================================="
echo "PBS Job ID: ${PBS_JOBID}"
echo "Running on host: $(hostname)"
echo "Start time: $(date)"
echo "Working directory: ${PBS_O_WORKDIR}"
echo "=============================================="

# Change to working directory
cd "${PBS_O_WORKDIR}"

# Load required modules (adjust for your system)
# module load cuda/11.8
# module load python/3.11

# Activate virtual environment
#source .venv/bin/activate

source my_setup.sh

# ============================================================================
# Determine cluster topology
# ============================================================================

# Get number of nodes from PBS
if [ -n "${PBS_NODEFILE}" ]; then
    NNODES=$(cat "${PBS_NODEFILE}" | sort -u | wc -l)
    NODES=($(cat "${PBS_NODEFILE}" | sort -u))
    MASTER_ADDR=${NODES[0]}
else
    NNODES=1
    MASTER_ADDR="localhost"
fi

# Get GPUs per node: set by submit.py via -v NGPUS_PER_NODE=N, otherwise detect
if [ -z "${NGPUS_PER_NODE}" ]; then
    NGPUS_PER_NODE=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l || echo 1)
fi

TOTAL_GPUS=$((NNODES * NGPUS_PER_NODE))
MASTER_PORT=${MASTER_PORT:-29500}

echo ""
echo "Cluster topology:"
echo "  Nodes: ${NNODES}"
echo "  GPUs per node: ${NGPUS_PER_NODE}"
echo "  Total GPUs: ${TOTAL_GPUS}"
echo "  Master: ${MASTER_ADDR}:${MASTER_PORT}"
if [ ${NNODES} -gt 1 ]; then
    echo "  Node list: ${NODES[*]}"
fi

# ============================================================================
# Set environment variables
# ============================================================================

export CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((NGPUS_PER_NODE-1)))
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export NCCL_DEBUG=${NCCL_DEBUG:-WARN}
export MASTER_ADDR=${MASTER_ADDR}
export MASTER_PORT=${MASTER_PORT}

# Polaris specific
export NCCL_NET_GDR_LEVEL=0
export NCCL_CROSS_NIC=1
export NCCL_COLLNET_ENABLE=1
#export NCCL_NET="AWS Libfabric"
#export LD_LIBRARY_PATH=/soft/libraries/aws-ofi-nccl/v1.9.1-aws/lib:$LD_LIBRARY_PATH
#export LD_LIBRARY_PATH=/soft/libraries/hwloc/lib/:$LD_LIBRARY_PATH
export FI_CXI_DISABLE_HOST_REGISTER=1
export FI_MR_CACHE_MONITOR=userfaultfd
export FI_CXI_DEFAULT_CQ_SIZE=131072
export TMPDIR=/tmp

# For multi-node: set network interface if needed
# export NCCL_SOCKET_IFNAME=eth0

# ============================================================================
# Launch training
# ============================================================================

TRAIN_SCRIPT="scripts/train.py"

if [ -z "${HYDRA_ARGS}" ]; then
    echo "ERROR: HYDRA_ARGS environment variable is not set."
    echo "Use scripts/submit.py to submit jobs, not this script directly."
    exit 1
fi

echo ""
echo "Hydra overrides: ${HYDRA_ARGS}"
echo ""

LAUNCHER=${LAUNCHER:-torchrun}
echo "Launcher: ${LAUNCHER}"

if [ ${NNODES} -eq 1 ] && [ ${NGPUS_PER_NODE} -eq 1 ]; then
    # Single GPU: run directly
    echo "Running single-GPU training..."
    launch_cmd=(
    python ${TRAIN_SCRIPT} ${HYDRA_ARGS}
    )

elif [ "${LAUNCHER}" = "mpiexec" ]; then
    # mpiexec: launch across all processes; train.py must read MPI rank env vars
    echo "Running distributed training with mpiexec..."
    NODEFILE=${PBS_NODEFILE}
    PYTHON_CMD="python ${TRAIN_SCRIPT} ${HYDRA_ARGS}"
    bash_cmd='
            export RANK=$PMI_RANK
            export LOCAL_RANK=$((PMI_RANK % NGPUS_PER_NODE))
            export CUDA_VISIBLE_DEVICES=$LOCAL_RANK
            echo "host=$(hostname) RANK=$RANK LOCAL_RANK=$LOCAL_RANK CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
            python $TRAIN_SCRIPT $HYDRA_ARGS
        '
    echo "Bash CMD"
    echo $bash_cmd
    launch_cmd=(
    mpiexec \
        -n ${TOTAL_GPUS} \
        --ppn ${NGPUS_PER_NODE} \
        --hostfile ${NODEFILE} \
        --cpu-bind none \
        -env MASTER_ADDR "$MASTER_ADDR" \
        -env MASTER_PORT "$MASTER_PORT" \
        -env WORLD_SIZE "$WORLD_SIZE" \
        -env NGPUS_PER_NODE "$NGPUS_PER_NODE"
        -env NCCL_DEBUG "$NCCL_DEBUG" \
        -env NCCL_IB_DISABLE "$NCCL_IB_DISABLE" \
        -env NCCL_NET_GDR_LEVEL "$NCCL_NET_GDR_LEVEL" \
        -env NCCL_P2P_DISABLE "$NCCL_P2P_DISABLE" \
        -env PYTHONNOUSERSITE "$PYTHONNOUSERSITE" \
        -env TRAIN_SCRIPT "$TRAIN_SCRIPT" \
        -env HYDRA_ARGS "$HYDRA_ARGS" \
        bash -lc "${bash_cmd}"
    )

elif [ ${NNODES} -eq 1 ]; then
    # Single node, multi-GPU: use torchrun standalone
    echo "Running multi-GPU training on single node..."
    launch_cmd=(
    torchrun \
        --standalone \
        --nproc_per_node=${NGPUS_PER_NODE} \
        ${TRAIN_SCRIPT} ${HYDRA_ARGS}
    )

else
    # Multi-node: use torchrun with rendezvous
    echo "Running multi-node training..."

    # Get this node's rank
    HOSTNAME=$(hostname)
    NODE_RANK=0
    for i in "${!NODES[@]}"; do
        if [[ "${NODES[$i]}" == "${HOSTNAME}"* ]]; then
            NODE_RANK=$i
            break
        fi
    done

    echo "This node: ${HOSTNAME}, rank: ${NODE_RANK}"

    launch_cmd=(
    torchrun \
        --nnodes=${NNODES} \
        --nproc_per_node=${NGPUS_PER_NODE} \
        --node_rank=${NODE_RANK} \
        --master_addr=${MASTER_ADDR} \
        --master_port=${MASTER_PORT} \
        ${TRAIN_SCRIPT} ${HYDRA_ARGS}
    )
fi

# ===========================================================================
# Write launch command to output directory
# ===========================================================================

# Parse output_dir and experiment_name from HYDRA_ARGS (fall back to defaults)
OUTPUT_DIR=$(echo "${HYDRA_ARGS}" | grep -oP 'output\.output_dir=\K\S+' || echo "outputs")
EXPERIMENT_NAME=$(echo "${HYDRA_ARGS}" | grep -oP 'output\.experiment_name=\K\S+' || echo "ParticleMan")

PBS_JOB_NUM=$(echo "${PBS_JOBID}" | cut -d'.' -f1)

echo "OUTPUT_DIR: ${OUTPUT_DIR}"
echo "EXPERIMENT_NAME: ${EXPERIMENT_NAME}"
echo "PBS_JOB_NUM: ${PBS_JOB_NUM}"

# Match by PBS job ID suffix - safe for concurrent jobs
RUN_DIR=$(ls -d "${OUTPUT_DIR}/${EXPERIMENT_NAME}/"*_pbs${PBS_JOB_NUM} 2>/dev/null)
mkdir -p $RUN_DIR
echo "RUN_DIR: ${RUN_DIR}"

LAUNCH_OUTPUT_FILE="${RUN_DIR}/launch_command.sh"

echo "${launch_cmd[@]}" > "${LAUNCH_OUTPUT_FILE}"

# ===========================================================================
# Run launch command
# ===========================================================================

"${launch_cmd[@]}"

echo ""
echo "=============================================="
echo "Training completed at: $(date)"
echo "=============================================="

# ============================================================================
# Copy PBS output file to run directory
# ============================================================================


if [ -n "${RUN_DIR}" ] && [ -d "${RUN_DIR}" ]; then
    PBS_OUTPUT_FILE="${PBS_O_WORKDIR}/particleman_train.o${PBS_JOB_NUM}"
    if [ -f "${PBS_OUTPUT_FILE}" ]; then
        cp "${PBS_OUTPUT_FILE}" "${RUN_DIR}/pbs_output.log"
        echo "PBS output copied to: ${RUN_DIR}/pbs_output.log"
    fi
    PBS_JOB_FILE="${PBS_O_WORKDIR}/job_${PBS_JOB_NUM}.pbs"
    if [ -f "${PBS_JOB_FILE}" ]; then
        cp "${PBS_JOB_FILE}" "${RUN_DIR}/job.pbs"
        echo "PBS job file copied to: ${RUN_DIR}/job.pbs"
    fi
else
    echo "Warning: Could not find run directory matching ${OUTPUT_DIR}/${EXPERIMENT_NAME}/*_pbs${PBS_JOB_NUM}"
fi
